# این فایل را به .env کپی کنید و مقادیر را پر کنید. هرگز .env را commit نکنید.

# --- Claude ---
ANTHROPIC_API_KEY=
# مدل پیش‌فرض: claude-opus-5-5
CLAUDE_MODEL=claude-opus-5-5

# --- Instagram Graph API (حساب Business یا Creator متصل به صفحه فیسبوک) ---
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_GRAPH_VERSION=v24.0
# graph.facebook.com برای ورود با فیسبوک، graph.instagram.com برای Instagram Login
IG_GRAPH_HOST=graph.facebook.com

# --- Telegram Bot API ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- تنظیمات ---
DATA_DIR=data
REPORT_LANGUAGE=fa
TIMEZONE=Asia/Tehran
# توضیح کوتاه درباره پیج شما تا پیشنهادها هدفمندتر باشند
ACCOUNT_BRIEF=
